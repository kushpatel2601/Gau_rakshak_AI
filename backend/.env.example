# Local development can use JSON history. Hosted deployments MUST set this true.
REQUIRE_MONGODB=false
MONGO_USERNAME=
MONGO_PASSWORD=
# Hostname only, e.g. cluster0.example.mongodb.net; never a mongodb+srv:// URI.
MONGO_CLUSTER=
DB_NAME=gaurakshak_db

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
INFERENCE_RUNTIME=tensorflow
MODEL_PATH=cattlenet_B4_phase1_epoch9.keras
# Only use a model artifact you have permission to distribute. Keep signed URLs secret.
MODEL_URL=
MODEL_SHA256=aa768d034c50ded6ccc042502fd5e4d76c15858832c149bfc1a7347fb21e82eb
